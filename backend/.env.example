# Скопируйте в backend/.env и при необходимости измените значения.
# Файл .env не коммитится (см. корневой .gitignore).

# Окружение: development | production
APP_ENV=development

# PostgreSQL (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://education:12345@localhost:5432/edudb

# ОБЯЗАТЕЛЬНО замените в production: минимум 32 случайных байта.
# Пример генерации: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-secret-change-me-0123456789abcdef

# ── Первый суперпользователь ────────────────────────────────────────────────
# Срабатывает ТОЛЬКО если таблица users пуста (первый запуск на чистой БД).
# Заполните оба значения, запустите backend один раз, затем УДАЛИТЕ строки
# SUPERADMIN_EMAIL и SUPERADMIN_PASSWORD из своего backend/.env: пользователь
# остаётся в БД, а пароль в открытом виде больше нигде не лежит.
# Пароль: минимум 8 символов; желательно заглавная буква и цифра.
# Если таблица users уже не пуста, а суперпользователя нет — примените
# `poetry run python -m scripts.create_superuser`.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origins фронтенда для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Логировать SQL-запросы (true/false)
SQL_ECHO=false

# Каталог загруженных файлов (аватары, презентации); по умолчанию backend/uploads
# UPLOADS_DIR=/absolute/path/to/uploads

# Ограничения аватара
MAX_AVATAR_SIZE=5242880
AVATAR_MAX_DIMENSION=512
AVATAR_MAX_PIXELS=20000000
